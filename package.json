{
  "name": "@gameowermedia/overplayer",
  "version": "1.2.0",
  "description": "React component for music and internet radio. Plays audio files and Icecast or Shoutcast streams in one playlist, with a LIVE badge, playback that survives navigation, and a headless hook.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "audio",
    "player",
    "music",
    "component",
    "persistent",
    "shuffle",
    "typescript",
    "live",
    "stream",
    "radio",
    "icecast",
    "shoutcast"
  ],
  "author": "GameOwerMedia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GameOwerMedia/OpenWebRadio.git"
  },
  "bugs": {
    "url": "https://github.com/GameOwerMedia/OpenWebRadio/issues"
  },
  "homepage": "https://github.com/GameOwerMedia/OpenWebRadio#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
